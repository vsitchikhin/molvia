{
  "name": "molvia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "backend",
    "bot",
    "packages/*",
    "deploy/watch"
  ],
  "scripts": {
    "dev": "concurrently -n api,pwa,bot -c blue,green,magenta \"npm:dev:api\" \"npm:dev:pwa\" \"npm:dev:bot\"",
    "dev:api": "npm run dev -w @molvia/backend",
    "dev:pwa": "npm run dev -w @molvia/frontend",
    "dev:bot": "npm run dev -w @molvia/bot",
    "lint": "npm run lint --workspaces --if-present && eslint . && npm run lint:style -w @molvia/frontend && node bin/check-code-map.mjs && node bin/design-md.mjs --check frontend/DESIGN.md",
    "format": "node bin/design-md.mjs --write frontend/DESIGN.md && prettier --write . && npm run lint:fix --workspaces --if-present && eslint . --fix && npm run lint:style -w @molvia/frontend -- --fix",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/model && tsc --noEmit -p packages/client && tsc --noEmit -p backend && tsc --noEmit -p bot && tsc --noEmit -p deploy/watch && vue-tsc --noEmit -p frontend && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate -w @molvia/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "postcss-html": "^2.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}

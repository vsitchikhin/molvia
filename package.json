{
  "name": "molvia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,pwa,bot -c blue,green,magenta \"npm:dev:api\" \"npm:dev:pwa\" \"npm:dev:bot\"",
    "dev:api": "npm run dev -w @molvia/api",
    "dev:pwa": "npm run dev -w @molvia/pwa",
    "dev:bot": "npm run dev -w @molvia/bot",
    "lint": "eslint . && stylelint \"**/*.{css,scss,vue}\"",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "format": "prettier --write . && eslint . --fix && stylelint \"**/*.{css,scss,vue}\" --fix",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p apps/pwa/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate -w @molvia/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}

# Образец: слепок для CLONE_INDEX=0. Руками не копировать — у копии свои порты:
#   bin/init-env.sh
# Индекс берётся из имени каталога (molvia → 0, molvia2 → 2) либо задаётся явно.
# Только литералы — подстановку ${...} dotenv не выполняет.
CLONE_INDEX=0
COMPOSE_PROJECT=molvia_0

API_PORT=3300
PWA_PORT=5300
POSTGRES_PORT=5500
# Адрес приложения — им бот отвечает на /start без кода. В проде это домен.
APP_BASE_URL=http://127.0.0.1:5300

POSTGRES_DB=molvia_0
POSTGRES_USER=molvia
POSTGRES_PASSWORD=molvia
DATABASE_URL=postgres://molvia:molvia@127.0.0.1:5500/molvia_0
# Integration tests get their own database on the same server, so a test run can
# never truncate the data you have been entering by hand.
TEST_DATABASE_URL=postgres://molvia:molvia@127.0.0.1:5500/molvia_0_test

# End-to-end gets the same protection, and its own ports with it (MOL-60): the run
# is dropped and recreated before every pass, and it cannot reach the dev stack even
# when `make dev` is up, because that one listens elsewhere.
E2E_API_PORT=3301
E2E_PWA_PORT=5301
E2E_DATABASE_URL=postgres://molvia:molvia@127.0.0.1:5500/molvia_0_e2e

# У КАЖДОЙ КОПИИ СВОЙ БОТ. Два процесса на одном токене воруют друг у друга
# апдейты через long polling — молча и невоспроизводимо. Завести отдельного
# в BotFather, если эта копия будет работать параллельно с другой.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — из него API собирает ссылку входа. Секрет внутреннего канала
# генерирует bin/init-env.sh один раз на копию; это НЕ токен бота.
TELEGRAM_BOT_USERNAME=
BOT_API_SECRET=

# Открытый API ЦБ Армении, ключа не требует
CBA_RATES_URL=https://cb.am/latest.json.php

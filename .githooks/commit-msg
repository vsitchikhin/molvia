#!/usr/bin/env bash
# Keeps commit messages in the format CLAUDE.md documents: Conventional Commits with the
# Jira key as scope. A regex rather than commitlint — the format is four lines of grammar
# and does not justify a dependency tree. The only author is the repository owner, so a
# co-author trailer is refused in any commit, merges included (MOL-372).
#
# Deliberate bypass: git commit --no-verify

set -euo pipefail

# Lines starting with `#` are git's comments, cut after this hook runs.
if grep -v '^#' "$1" | grep -Eiq '^[[:space:]]*co-?authored-?by[[:space:]]*:'; then
  cat >&2 <<'MSG'
commit-msg: the message names a co-author.

  The only author is the repository owner: a Co-Authored-By line in any
  form is forbidden (CLAUDE.md, «Commits»). Remove the line and commit again.
MSG
  exit 1
fi

subject=$(head -n 1 "$1")

# Merges, reverts and the fixup/squash markers rebase produces are none of our business.
case "$subject" in
  Merge\ * | Revert\ * | fixup!* | squash!* | amend!*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|test|docs|chore|ci|style|build)(\(MOL-[0-9]+\))?!?: [^ ].{0,79}$'

if [[ ! $subject =~ $pattern ]]; then
  cat >&2 <<'MSG'
commit-msg: the subject line does not match the house format.

  <type>(MOL-<n>): <imperative summary>

  type   feat fix refactor perf test docs chore ci style build
  scope  the Jira key of the task, e.g. (MOL-6). The tracker is a separate
         system and this key is the only link between a commit and its task.
         Omit it only for work that has no task at all.
  limit  80 characters after the colon

  e.g.   feat(MOL-6): add the catalogue schema and its index
MSG
  echo "  got    $subject" >&2
  exit 1
fi

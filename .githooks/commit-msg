#!/usr/bin/env bash
# Keeps commit messages in the format CLAUDE.md documents: Conventional Commits with the
# app as scope. A regex rather than commitlint — the format is four lines of grammar and
# does not justify a dependency tree.
#
# Deliberate bypass: git commit --no-verify

set -euo pipefail

subject=$(head -n 1 "$1")

# Merges, reverts and the fixup/squash markers rebase produces are none of our business.
case "$subject" in
  Merge\ * | Revert\ * | fixup!* | squash!* | amend!*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|test|docs|chore|ci|style|build)(\([a-z0-9.-]+\))?!?: [^ ].{0,79}$'

if [[ ! $subject =~ $pattern ]]; then
  cat >&2 <<'MSG'
commit-msg: the subject line does not match the house format.

  <type>(<scope>): <imperative summary>

  type   feat fix refactor perf test docs chore ci style build
  scope  optional, the app or package: pwa, api, bot, model, client, db, deps
  limit  80 characters after the colon

  e.g.   feat(pwa): show the unit price next to every verdict
MSG
  echo "  got    $subject" >&2
  exit 1
fi

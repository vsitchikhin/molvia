#!/usr/bin/env bash
# Refuses a push whose types, unit, component or integration tests are not green. The push is
# the moment the work leaves this machine; formatting and lint already ran at commit time.
#
# End-to-end is CI's (MOL-164): the same suite runs there on every push, with no queue, and a pull
# request merges only when it is green. Here it held every copy's push in one line for minutes.
# `make e2e` still runs it on demand.
#
# The copies on this machine take turns (MOL-139): a push waits while another copy's push or
# `make check` runs, and says whose. A step that already passed on this very tree — by
# `make check`, or by a push the remote then rejected — is not run again.
#
# Deliberate bypass: git push --no-verify

set -euo pipefail

if [[ -z "${MOLVIA_ONE_AT_A_TIME:-}" ]]; then
  exec bin/one-at-a-time.sh pre-push "$0" "$@"
fi

step() {
  local name=$1 title=$2
  shift 2
  if bin/green.sh has "$name"; then
    echo "pre-push: $title — already green on this tree"
    return
  fi
  echo "pre-push: $title"
  "$@"
  bin/green.sh record "$name"
}

step typecheck "types" npm run --silent typecheck
step test "unit, component and integration tests" npm run --silent test

echo "pre-push: green"

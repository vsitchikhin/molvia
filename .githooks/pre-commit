#!/usr/bin/env bash
# Refuses a commit whose files are not formatted by Prettier — the files of this commit only.
#
# Everything else is CI's (MOL-165): lint, types, every test. The copies on this machine ran a
# type-aware lint of the whole repository at every commit, past the queue of MOL-139, and the
# machine was too loaded to finish their pushes; `master` takes a pull request only when CI is
# green, so a check here guarded nothing CI does not. Prettier stays because CI checks formatting
# rather than fixing it, and these files take it in seconds.
#
# Deliberate bypass: git commit --no-verify

set -euo pipefail

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[[ ${#files[@]} -gt 0 ]] || exit 0

if ! npx --no-install prettier --check --ignore-unknown --log-level warn -- "${files[@]}"; then
  echo "pre-commit: not formatted — npx prettier --write <the files above>, then add them again" >&2
  exit 1
fi

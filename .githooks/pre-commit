#!/usr/bin/env bash
# Refuses a commit whose formatting or lint is not clean.
#
# It checks the working tree, not just the staged hunks: with a single author and a repo
# this size that is the honest thing to check, and a partial commit that only looks clean
# in isolation is worse than a slightly wider check.
#
# Deliberate bypass: git commit --no-verify

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '\.(ts|vue|scss|css|json|js|mjs|cjs|ya?ml|md)$'; then
  exit 0
fi

echo "pre-commit: formatting"
npm run --silent format:check

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: clean"

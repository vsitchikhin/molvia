# Production environment. Copy to .env.prod ON THE SERVER and fill in; never commit it.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Hostname that resolves to this machine. Caddy issues and renews the certificate for it.
DOMAIN=molvia.net

POSTGRES_DB=molvia
POSTGRES_USER=molvia
# Compose puts it into the API's DATABASE_URL as it is, so it holds only what a URL takes bare — a «/»
# of base64 stops the API (MOL-287). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# The password of `molvia_metrics`, the role postgres_exporter logs in as (MOL-366): `pg_monitor` and no
# table. The API sets it at every start and closes what the old one opened. Printable ASCII, 24 at least.
# Generate: openssl rand -hex 24. deploy/README.md, «Rotating the secrets».
METRICS_DB_PASSWORD=

# The production bot, a different one from any development bot: two processes on one
# token steal each other's updates through long polling.
TELEGRAM_BOT_TOKEN=

# Username without @ and an independent 32-byte base64url secret shared by API and bot.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
TELEGRAM_BOT_USERNAME=
BOT_API_SECRET=

# The address Open Food Facts may reach us at, sent in every request's User-Agent (MOL-162). The
# base asks for one and may ban a client without it. Empty switches the name hint off.
OPEN_FOOD_FACTS_CONTACT=

# The address the Serbian tax office may reach us at, sent in every ask of its check of a receipt by
# its QR code's link (MOL-232) — the same address does. Empty: such receipts are taken and wait.
PURS_CONTACT=

# The model that reads the receipts of those it is granted to (MOL-272). Empty: Tesseract reads every
# receipt. A person's key (sk-ant-usr-…) needs its workspace; a key made inside one needs none. The cap
# is what the model may cost a calendar month in UTC, the console's workspace limit set to the same.
# deploy/README.md, «Login configuration».
CLAUDE_API_KEY=
CLAUDE_WORKSPACE_ID=
RECEIPT_MODEL_MONTHLY_CAP_USD=200
RECEIPT_MODEL_PERSON_MONTHLY_CAP_USD=2

# The nightly merge of twins in the catalogue (MOL-106): `on` merges — production's from MOL-358, set by the owner's word after its merge;
# `report` (the compose file's default) tells the owner each morning what it would merge and merges
# nothing (it only sweeps after a merge made by hand). `make unmerge ID=` takes one back,
# `make merge-candidates` lists the open candidates.
CATALOGUE_MERGE=on

# The bot's pulse (MOL-142): the ping URL of the healthchecks.io check «molvia-bot», hit after a
# claim of reminders went through, at most once in five minutes. Whoever has it can say «alive»
# for the bot, so it is kept like a secret. The line is required — a forgotten one refuses to start,
# since a check that never got a ping never raises an alarm; empty, on purpose, sends nothing.
# deploy/README.md, «Signals».
BOT_PULSE_URL=

# The owner's Telegram id (MOL-143), digits only: whom the bot tells of a new failure of the API or the
# bot, and whom Grafana writes the alarms to (MOL-145). Required and filled — compose refuses to start
# without it; there is no longer a way to tell nobody. deploy/README.md, «Signals», «Metrics».
OWNER_TELEGRAM_ID=

# Grafana (MOL-145): the password of `admin`, behind the SSH tunnel. Required — compose refuses to
# start without it. Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# The alarms' own bot (MOL-145, В-3), never the production bot above: its token lives only in
# Grafana, a container that goes to the internet. The owner writes it /start once, or it cannot write
# first. Whom it writes is OWNER_TELEGRAM_ID. deploy/README.md, «Metrics».
ALERTS_BOT_TOKEN=

# The alarms' pulse (MOL-145): the ping URL of the healthchecks.io check «molvia-alerts», hit by Grafana
# every five minutes while it counts its rules and VictoriaMetrics answers. Kept like a secret. Required.
ALERTS_PULSE_URL=

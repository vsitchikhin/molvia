# Production environment. Copy to .env.prod ON THE SERVER and fill in; never commit it.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Hostname that resolves to this machine. Caddy issues and renews the certificate for it.
DOMAIN=molvia.com

POSTGRES_DB=molvia
POSTGRES_USER=molvia
POSTGRES_PASSWORD=

# The production bot, a different one from any development bot: two processes on one
# token steal each other's updates through long polling.
TELEGRAM_BOT_TOKEN=

# The door of the first visit. Without it POST /actors would create an identity for anyone
# who finds the domain, and the 0.2 gate counts arrivals as its denominator. The link handed
# to people carries it: https://<domain>/?c=<code>. Any long random string will do:
#   openssl rand -hex 8
# The API refuses to start if this is empty — a server nobody can sign into is easier to
# notice than one anybody can.
SIGNUP_CODE=

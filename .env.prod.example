# Production environment. Copy to .env.prod ON THE SERVER and fill in; never commit it.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Hostname that resolves to this machine. Caddy issues and renews the certificate for it.
DOMAIN=molvia.net

POSTGRES_DB=molvia
POSTGRES_USER=molvia
POSTGRES_PASSWORD=

# The production bot, a different one from any development bot: two processes on one
# token steal each other's updates through long polling.
TELEGRAM_BOT_TOKEN=

# Username without @ and an independent 32-byte base64url secret shared by API and bot.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
TELEGRAM_BOT_USERNAME=
BOT_API_SECRET=

# The address Open Food Facts may reach us at, sent in every request's User-Agent (MOL-162). The
# base asks for one and may ban a client without it. Empty switches the name hint off.
OPEN_FOOD_FACTS_CONTACT=

# The bot's pulse (MOL-142): the ping URL of the healthchecks.io check «molvia-bot», hit after a
# claim of reminders went through, at most once in five minutes. Whoever has it can say «alive»
# for the bot, so it is kept like a secret. The line is required — a forgotten one refuses to start,
# since a check that never got a ping never raises an alarm; empty, on purpose, sends nothing.
# deploy/README.md, «Signals».
BOT_PULSE_URL=

# The owner's Telegram id (MOL-143): whom the bot tells of a new failure of the API or the bot.
# Required as a line, as BOT_PULSE_URL is — a forgotten one would leave every failure silent; empty,
# on purpose, keeps the failures in their table and tells nobody. deploy/README.md, «Signals».
OWNER_TELEGRAM_ID=

{
  "name": "@molvia/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "forget": "tsx src/forget-cli.ts",
    "seed": "tsx src/seed-catalogue-cli.ts",
    "gates": "tsx src/gates-cli.ts",
    "failures": "tsx src/failures-cli.ts",
    "merge": "tsx src/merge-cli.ts",
    "notify": "tsx src/notify-cli.ts",
    "bundle": "node ../bin/bundle.mjs backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

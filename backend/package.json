{
  "name": "@molvia/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "forget": "tsx src/forget-cli.ts",
    "bundle": "node ../bin/bundle.mjs backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && vitest run -c vitest.integration.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:attack": "vitest run -c vitest.attack.config.ts"
  },
  "dependencies": {
    "@molvia/model": "*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}

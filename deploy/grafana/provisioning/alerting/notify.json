{
  "apiVersion": 1,
  "templates": [
    {
      "orgId": 1,
      "name": "molvia",
      "template": "{{ define \"molvia\" }}{{ range .Alerts.Firing }}🔥 {{ .Labels.alertname }}\n{{ .Annotations.summary }}\n{{ with .Annotations.Error }}Запрос не выполнился: {{ . }}\n{{ end }}{{ end }}{{ range .Alerts.Resolved }}✅ Прошло: {{ .Labels.alertname }}\n{{ end }}Дашборд — через туннель, deploy/README.md «Metrics».{{ end }}"
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "telegram",
      "receivers": [
        {
          "uid": "molvia-telegram",
          "type": "telegram",
          "settings": {
            "bottoken": "$__env{ALERTS_BOT_TOKEN}",
            "chatid": "OWNER_TELEGRAM_ID, written by start.sh",
            "message": "{{ template \"molvia\" . }}",
            "parse_mode": "None",
            "disable_web_page_preview": true
          },
          "disableResolveMessage": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "pulse",
      "receivers": [
        {
          "uid": "molvia-pulse",
          "type": "webhook",
          "settings": {
            "url": "$__env{ALERTS_PULSE_URL}",
            "httpMethod": "POST"
          },
          "disableResolveMessage": true
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "telegram",
      "group_by": ["alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "6h",
      "routes": [
        {
          "receiver": "pulse",
          "object_matchers": [["pulse", "=", "true"]],
          "group_by": ["alertname"],
          "group_wait": "0s",
          "group_interval": "1m",
          "repeat_interval": "5m",
          "continue": false
        }
      ]
    }
  ]
}

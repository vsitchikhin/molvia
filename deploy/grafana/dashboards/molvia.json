      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(molvia_http_request_duration_seconds_bucket{route!~\"unmatched|/health|/internal/.*|/receipts/:receiptId/parts/:part\"}[5m])))",
          "legendFormat": ""

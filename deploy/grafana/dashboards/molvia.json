        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria"
          },
          "expr": "(sum(rate(molvia_http_requests_total{route!~\"unmatched|/health|/internal/.*\",status=\"5xx\"}[5m])) or vector(0)) / sum(rate(molvia_http_requests_total{route!~\"unmatched|/health|/internal/.*\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Ответы людям: без 404 сканеров, /health и запросов бота. Тревога — выше 5 % за 5 минут, если таких запросов не меньше 20."
    },

# ~/molvia/backup.env on the server, mode 600 (MOL-70). The owner fills it in; never commit it.

# The owner's age public key (age-keygen prints it). The private key never comes to the server.
AGE_RECIPIENT=age1...

# The rclone remote and bucket: Cloudflare R2, bucket in the EU jurisdiction.
RCLONE_REMOTE=r2:molvia-backups

# The healthchecks.io ping URL of the «molvia-backup» check, without a trailing slash.
HC_URL=https://hc-ping.com/...

# The privacy page says fourteen days. The bucket's own lifecycle rule deletes at 13, because R2
# removes an object within a day of its expiry; this is the same number, as a fallback.
DELETE_AFTER_DAYS=13

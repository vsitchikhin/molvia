# The nightly copy of the database (MOL-70). Installed to /etc/systemd/system; see deploy/README.md.
[Unit]
Description=Molvia: encrypted copy of the production database
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
ExecStart=/home/deploy/molvia/backup/backup.sh
